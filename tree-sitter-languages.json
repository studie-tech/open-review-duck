    },
    "kotlin": {
      "asset": "tree-sitter-kotlin.wasm",
      "source": "tree-sitter-wasms/out/tree-sitter-kotlin.wasm",
      "extensions": [".kt", ".kts"],
      "lexical": "c-family"
    },
    "css": {
      "asset": "tree-sitter-css.wasm",
      "source": "@cursorless/tree-sitter-wasms/out/tree-sitter-css.wasm",
      "extensions": [".css"],
      "lexical": "block-comment"
    },
    "dart": {
      "asset": "tree-sitter-dart.wasm",
      "source": "@cursorless/tree-sitter-wasms/out/tree-sitter-dart.wasm",
      "extensions": [".dart"],
      "lexical": "c-family"
    },
    "elisp": {
      "asset": "tree-sitter-elisp.wasm",
      "source": "tree-sitter-wasms/out/tree-sitter-elisp.wasm",
