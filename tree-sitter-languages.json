    },
    "html": {
      "asset": "tree-sitter-html.wasm",
      "source": "@cursorless/tree-sitter-wasms/out/tree-sitter-html.wasm",
      "extensions": [".html", ".htm"],
      "lexical": "markup"
    },
    "json": {
      "asset": "tree-sitter-json.wasm",
