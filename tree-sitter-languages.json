{
  "lexicalSyntaxes": {
    "c-family": {
      "lineComments": ["//"],
      "blockComments": [["/*", "*/"]],
      "quotes": ["\"", "'"]
    },
    "backtick-directive": {
      "lineComments": ["//"],
      "blockComments": [["/*", "*/"]],
      "quotes": ["\""],
      "directive": "`"
    },
    "c-preprocessor": {
      "lineComments": ["//"],
      "blockComments": [["/*", "*/"]],
      "quotes": ["\"", "'"],
      "directive": "#"
    },
    "js-family": {
      "lineComments": ["//"],
      "blockComments": [["/*", "*/"]],
      "quotes": ["\"", "'", "`"]
    },
    "block-comment": {
      "blockComments": [["/*", "*/"]],
      "quotes": ["\"", "'"]
    },
    "hash": {
      "lineComments": ["#"],
      "quotes": ["\"", "'"]
    },
    "hash-double-quote": {
      "lineComments": ["#"],
      "quotes": ["\""]
    },
    "hash-block": {
      "lineComments": ["#"],
      "blockComments": [["/*", "*/"]],
      "quotes": ["\""]
    },
    "hash-slash": {
      "lineComments": ["#", "//"],
      "blockComments": [["/*", "*/"]],
      "quotes": ["\""]
    },
    "hash-slash-quotes": {
      "lineComments": ["//", "#"],
      "blockComments": [["/*", "*/"]],
      "quotes": ["\"", "'"]
    },
    "hash-equals-block": {
      "lineComments": ["#"],
      "blockComments": [["#=", "=#"]],
      "quotes": ["\"", "'"]
    },
    "hash-angle-block": {
      "lineComments": ["#"],
      "blockComments": [["<#", "#>"]],
      "quotes": ["\"", "'"]
    },
    "dash-block": {
      "lineComments": ["--"],
      "blockComments": [["/*", "*/"]],
      "quotes": ["'", "\""]
    },
    "dash-brace-block": {
      "lineComments": ["--"],
      "blockComments": [["{-", "-}"]],
      "quotes": ["\""]
    },
    "dash-bracket-block": {
      "lineComments": ["--"],
      "blockComments": [["--[[", "]]"]],
      "quotes": ["\"", "'"]
    },
    "semicolon": {
      "lineComments": [";"],
      "quotes": ["\""]
    },
    "semicolon-hash": {
      "lineComments": [";", "#"],
      "quotes": ["\"", "'"]
    },
    "percent": {
      "lineComments": ["%"],
      "quotes": ["\"", "'"]
    },
    "percent-only": {
      "lineComments": ["%"],
      "quotes": []
    },
    "bang": {
      "lineComments": ["!"],
      "quotes": ["\"", "'"]
    },
    "paren-star-block": {
      "blockComments": [["(*", "*)"]],
      "quotes": ["\""]
    },
    "slash-paren-star-block": {
      "lineComments": ["//"],
      "blockComments": [["(*", "*)"]],
      "quotes": ["\""]
    },
    "backslash-star": {
      "lineComments": ["\\*"],
      "blockComments": [["(*", "*)"]],
      "quotes": ["\""]
    },
    "markup": {
      "blockComments": [["<!--", "-->"]],
      "quotes": ["\"", "'"]
    },
    "double-quote-only": {
      "quotes": ["\""]
    }
  },
  "languages": {
    "javascript": {
      "asset": "tree-sitter-javascript.wasm",
      "source": "tree-sitter-wasms/out/tree-sitter-javascript.wasm",
      "extensions": [".js", ".jsx", ".mjs", ".cjs"],
      "lexical": "js-family"
    },
    "typescript": {
      "asset": "tree-sitter-typescript.wasm",
      "source": "tree-sitter-wasms/out/tree-sitter-tsx.wasm",
      "extensions": [".ts", ".tsx", ".mts", ".cts"],
      "lexical": "js-family"
    },
    "python": {
      "asset": "tree-sitter-python.wasm",
      "source": "tree-sitter-wasms/out/tree-sitter-python.wasm",
      "extensions": [".py", ".pyi"],
      "lexical": "hash"
    },
    "java": {
      "asset": "tree-sitter-java.wasm",
      "source": "tree-sitter-wasms/out/tree-sitter-java.wasm",
      "extensions": [".java"],
      "lexical": "c-family"
    },
    "csharp": {
      "asset": "tree-sitter-csharp.wasm",
      "source": "tree-sitter-wasms/out/tree-sitter-c_sharp.wasm",
      "extensions": [".cs", ".csx"],
      "lexical": "c-preprocessor"
    },
    "cpp": {
      "asset": "tree-sitter-cpp.wasm",
      "source": "tree-sitter-wasms/out/tree-sitter-cpp.wasm",
      "extensions": [
        ".cpp",
        ".cc",
        ".cxx",
        ".c++",
        ".hpp",
        ".hh",
        ".hxx",
        ".h++",
        ".ipp",
        ".tpp",
        ".inl"
      ],
      "lexical": "c-preprocessor"
    },
    "php": {
      "asset": "tree-sitter-php.wasm",
      "source": "tree-sitter-wasms/out/tree-sitter-php.wasm",
      "extensions": [".php", ".phtml", ".inc"],
      "lexical": "hash-slash-quotes"
    },
    "shell": {
      "asset": "tree-sitter-shell.wasm",
      "source": "tree-sitter-bash/tree-sitter-bash.wasm",
      "extensions": [".sh", ".bash", ".zsh", ".ksh"],
      "fileNames": [".bashrc", ".zshrc", ".profile"],
      "lexical": "hash"
    },
    "c": {
      "asset": "tree-sitter-c.wasm",
      "source": "tree-sitter-wasms/out/tree-sitter-c.wasm",
      "extensions": [".c", ".h"],
      "lexical": "c-preprocessor"
    },
    "ruby": {
      "asset": "tree-sitter-ruby.wasm",
      "source": "tree-sitter-wasms/out/tree-sitter-ruby.wasm",
      "extensions": [".rb", ".rake", ".gemspec"],
      "fileNames": ["rakefile", "gemfile"],
      "lexical": "hash"
    },
    "hcl": {
      "asset": "tree-sitter-hcl.wasm",
      "source": "@tree-sitter-grammars/tree-sitter-hcl/tree-sitter-hcl.wasm",
      "extensions": [".hcl", ".tf", ".tfvars"],
      "lexical": "hash-slash"
    },
    "rust": {
      "asset": "tree-sitter-rust.wasm",
      "source": "tree-sitter-wasms/out/tree-sitter-rust.wasm",
      "extensions": [".rs"],
      "lexical": "c-family"
    },
    "lua": {
      "asset": "tree-sitter-lua.wasm",
      "source": "@cursorless/tree-sitter-wasms/out/tree-sitter-lua.wasm",
      "extensions": [".lua"],
      "lexical": "dash-bracket-block"
    },
    "go": {
      "asset": "tree-sitter-go.wasm",
      "source": "tree-sitter-wasms/out/tree-sitter-go.wasm",
      "extensions": [".go"],
      "lexical": "js-family"
    },
    "makefile": {
      "asset": "tree-sitter-makefile.wasm",
      "source": "tree-sitter-make/tree-sitter-make.wasm",
      "extensions": [".mk"],
      "fileNames": ["makefile", "gnumakefile"],
