    "elm": {
      "asset": "tree-sitter-elm.wasm",
      "source": "@cursorless/tree-sitter-wasms/out/tree-sitter-elm.wasm",
      "extensions": [".elm"],
      "lexical": "dash-brace-block"
    },
    "embedded_template": {
      "asset": "tree-sitter-embedded-template.wasm",
