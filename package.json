    "@lumis-sh/wasm-sql": "0.26.1",
    "@lumis-sh/wasm-svelte": "0.26.0",
    "@lumis-sh/wasm-systemverilog": "0.26.2",
    "@node-rs/argon2": "2.0.2",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@plurnk/plurnk-mimetypes-grammar-fsharp": "1.3.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@sentry/nextjs": "10.69.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.101.2",
    "@tree-sitter-grammars/tree-sitter-hcl": "1.2.0",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@workflow/world-postgres": "4.3.2",
    "@xstate/react": "6.1.0",
    "ai": "7.0.41",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ignore": "7.0.5",
    "jose": "6.2.4",
    "lucide-react": "^1.25.0",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.6.0",
    "tree-sitter-bash": "0.25.1",
    "tree-sitter-groovy": "0.1.2",
    "tree-sitter-julia": "0.23.1",
    "tree-sitter-make": "1.1.1",
    "tree-sitter-powershell": "0.26.4",
    "tree-sitter-wasms": "0.1.13",
    "uploadthing": "7.7.4",
