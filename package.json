{
  "name": "reviewduck",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "build": "node scripts/prepare-tree-sitter.mjs && next build --webpack",
    "check": "pnpm docstrings:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "dev": "node scripts/prepare-tree-sitter.mjs && next dev --turbo",
    "docstrings:check": "node scripts/check-docstrings.mjs",
    "format:check": "biome format .",
    "format:write": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "preview": "node scripts/prepare-tree-sitter.mjs && next build && next start",
    "start": "next start",
    "local:admin": "node scripts/local-admin.mjs",
    "local:bootstrap": "node scripts/local-bootstrap.mjs",
    "workflow:bootstrap": "workflow bootstrap",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/prepare-tree-sitter.mjs && vitest",
    "test:run": "node scripts/prepare-tree-sitter.mjs && vitest run",
    "test:integration": "node scripts/prepare-tree-sitter.mjs && vitest run --config vitest.integration.config.ts",
    "test:integration:coverage": "node scripts/prepare-tree-sitter.mjs && vitest run --coverage --config vitest.integration.config.ts",
    "test:coverage": "node scripts/prepare-tree-sitter.mjs && vitest run --coverage",
    "test:e2e:local": "playwright test --config playwright.local.config.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.23",
    "@ai-sdk/openai": "4.0.23",
    "@ai-sdk/openai-compatible": "3.0.16",
    "@ai-sdk/provider-utils": "5.0.14",
    "@aws-sdk/client-kms": "3.1097.0",
    "@aws-sdk/credential-providers": "3.1097.0",
    "@clerk/nextjs": "^7.5.20",
    "@cursorless/tree-sitter-wasms": "0.9.0",
    "@lumis-sh/wasm-asm": "0.26.2",
    "@lumis-sh/wasm-astro": "0.26.1",
    "@lumis-sh/wasm-dockerfile": "0.26.1",
    "@lumis-sh/wasm-erlang": "0.26.1",
    "@lumis-sh/wasm-fortran": "0.26.1",
    "@lumis-sh/wasm-graphql": "0.26.0",
    "@lumis-sh/wasm-prisma": "0.26.1",
