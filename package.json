{
  "name": "reviewduck",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "assets:prepare": "node scripts/prepare-tree-sitter.mjs && node scripts/generate-rulebooks.mjs && node scripts/check-generated-assets.mjs",
    "audit:prod": "pnpm audit --prod --audit-level moderate --ignore-registry-errors",
    "biome:scope:check": "node scripts/check-biome-scope.mjs",
    "build": "pnpm assets:prepare && next build --webpack",
    "build:vercel": "node scripts/vercel-build.mjs",
    "check": "pnpm make:check && pnpm biome:scope:check && pnpm docstrings:check && pnpm db:order:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run",
    "db:generate": "drizzle-kit generate && node scripts/order-migration-constraints.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "dev": "pnpm assets:prepare && next dev --turbo --hostname 127.0.0.1",
    "docstrings:check": "node scripts/check-docstrings.mjs",
    "format:check": "biome format .",
    "format:write": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "preview": "pnpm assets:prepare && next build && next start --hostname 127.0.0.1",
    "start": "next start --hostname 127.0.0.1",
    "local:admin": "node scripts/local-admin.mjs",
    "local:bootstrap": "node scripts/local-bootstrap.mjs",
    "workflow:bootstrap": "workflow bootstrap",
    "typecheck": "tsc --noEmit",
    "test": "pnpm assets:prepare && vitest",
    "test:run": "pnpm assets:prepare && vitest run",
    "test:integration": "pnpm assets:prepare && vitest run --config vitest.integration.config.ts",
    "test:integration:coverage": "pnpm assets:prepare && vitest run --coverage --config vitest.integration.config.ts",
    "test:coverage": "pnpm assets:prepare && vitest run --coverage",
    "test:e2e:local": "playwright test --config playwright.local.config.ts",
    "rulebooks:generate": "node scripts/generate-rulebooks.mjs",
    "make:check": "node scripts/check-makefile-delegation.mjs",
    "db:order": "node scripts/order-migration-constraints.mjs",
    "db:order:check": "node scripts/order-migration-constraints.mjs --check"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.62",
    "@ai-sdk/provider-utils": "5.0.53",
    "@clerk/nextjs": "^7.9.10",
    "@cursorless/tree-sitter-wasms": "0.10.0",
    "@lumis-sh/wasm-asm": "0.26.4",
    "@lumis-sh/wasm-astro": "0.26.3",
    "@lumis-sh/wasm-dockerfile": "0.26.3",
    "@lumis-sh/wasm-erlang": "0.26.5",
    "@lumis-sh/wasm-fortran": "0.26.3",
    "@lumis-sh/wasm-graphql": "0.26.3",
    "@lumis-sh/wasm-prisma": "0.26.3",
    "@lumis-sh/wasm-protobuf": "0.26.5",
    "@lumis-sh/wasm-sql": "0.26.1",
    "@lumis-sh/wasm-svelte": "0.26.3",
    "@lumis-sh/wasm-systemverilog": "0.26.6",
    "@node-rs/argon2": "2.2.1",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@plurnk/plurnk-mimetypes-grammar-fsharp": "1.16.2",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/nextjs": "10.70.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.104.1",
    "@tree-sitter-grammars/tree-sitter-hcl": "1.2.0",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@workflow/world-postgres": "5.0.1",
    "ai": "7.0.127",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "ignore": "7.0.12",
    "jose": "6.2.12",
    "lucide-react": "^1.52.0",
    "mermaid": "^12.1.0",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "tree-sitter-bash": "0.25.1",
    "tree-sitter-groovy": "0.1.2",
    "tree-sitter-julia": "0.23.1",
    "tree-sitter-make": "1.1.1",
    "tree-sitter-powershell": "0.26.4",
    "tree-sitter-wasms": "0.1.13",
    "uploadthing": "7.7.4",
    "web-tree-sitter": "0.25.10",
    "workflow": "5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.2",
    "postcss": "8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
