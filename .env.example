# SaaS deployment target. The published appliance supplies "local" itself.
DEPLOYMENT_MODE="saas"
NEXT_PUBLIC_DEPLOYMENT_MODE="saas"
APP_URL="https://review.example.com"

# PlanetScale PostgreSQL 18: pooled runtime and direct migration endpoints.
DATABASE_URL="postgresql://user:password@host.pg.psdb.cloud:6432/postgres?sslmode=verify-full&sslrootcert=system"
MIGRATION_DATABASE_URL="postgresql://user:password@host.pg.psdb.cloud:5432/postgres?sslmode=verify-full&sslrootcert=system"

# Clerk authentication and workspace billing.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_replace_me"
CLERK_SECRET_KEY="sk_live_replace_me"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_replace_me"

# Private UploadThing source storage in fra1.
UPLOADTHING_TOKEN=""
STORAGE_ID_KEY=""

# AWS KMS envelope encryption through Vercel OIDC (no static AWS key).
KMS_KEY_ID=""
KMS_REGION="eu-central-1"
AWS_KMS_ROLE_ARN=""

# App/OAuth integrations.
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""
GITLAB_WEBHOOK_SECRET=""
AZURE_ENTRA_CLIENT_ID=""
AZURE_ENTRA_CLIENT_SECRET=""
AZURE_ENTRA_TENANT_ID="common"
AZURE_WEBHOOK_SECRET=""
OAUTH_STATE_SECRET=""

# Managed AI. Production fails closed when the paid catalog/budget is absent.
OPENCODE_API_KEY=""
OPENCODE_PUBLIC_BASE_URL="https://opencode.ai/zen/v1"
BIG_PICKLE_DISCLOSURE_VERSION="2026-07-29"
OPENROUTER_MANAGEMENT_KEY=""
OPENROUTER_MODEL_ALLOWLIST=""
OPENROUTER_WORKSPACE_MONTHLY_LIMIT_USD=""
MANAGED_AI_DAILY_REQUEST_LIMIT="40"
MANAGED_AI_USER_DAILY_REQUEST_LIMIT="10"
MANAGED_AI_WEEKLY_TOKEN_LIMIT="250000"
AI_MAX_MODEL_STEPS="64"
AI_MAX_TOOL_CALLS="256"
AI_MAX_DISTINCT_FILES="200"
AI_MAX_SOURCE_BYTES="8388608"
AI_MAX_DURATION_MS="1800000"

# Sentry SaaS observability. SENTRY_AUTH_TOKEN is CI-only.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
SENTRY_ORG=""
SENTRY_PROJECT=""

# One authenticated daily maintenance invocation.
CRON_SECRET=""
SOURCE_RETENTION_DAYS="30"
SOURCE_RETENTION_SNAPSHOTS="5"

ALLOW_PRIVATE_PROVIDER_HOSTS="false"
ALLOW_PRIVATE_AI_HOSTS="false"
