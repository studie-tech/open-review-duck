# SaaS deployment target. The published appliance supplies "local" itself.
DEPLOYMENT_MODE="saas"
NEXT_PUBLIC_DEPLOYMENT_MODE="saas"
APP_URL="https://review.example.com"

# PlanetScale PostgreSQL 18: pooled runtime and direct migration endpoints.
DATABASE_URL="postgresql://user:password@host.pg.psdb.cloud:6432/postgres?sslmode=verify-full&sslrootcert=system"
MIGRATION_DATABASE_URL="postgresql://user:password@host.pg.psdb.cloud:5432/postgres?sslmode=verify-full&sslrootcert=system"
# Runtime pool size in production, sized to the deep reviewer's fan-out:
# DEEP_REVIEW_EXECUTION_SLOTS x DEEP_REVIEW_TOOL_SLOTS, plus polling, cron, and
# headroom. Every concurrent serverless instance carries its own pool, so keep
# the total under the database's max_connections.
DATABASE_POOL_MAX="5"

# Clerk authentication and workspace billing. Configure Pro at $20/month with
# the `paid_ai_models` feature, Scale at $100/month with `managed_ai_scale`, and
# Ultra at $200/month with `managed_ai_ultra`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_replace_me"
CLERK_SECRET_KEY="sk_live_replace_me"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_replace_me"

# Private UploadThing source storage in fra1.
UPLOADTHING_TOKEN=""
STORAGE_ID_KEY=""

# Shared 256-bit vault root. Generate with: openssl rand -base64 32
# Store this as a Vercel Sensitive Environment Variable.
ENCRYPTION_KEY=

# Signs one-time OAuth state. Generate a distinct value per environment with:
# openssl rand -base64 32
OAUTH_STATE_SECRET=

# Register a GitHub App at https://github.com/settings/apps/new.
# Set both its setup URL and callback URL to
# ${APP_URL}/github/complete. Leave "Request user authorization
# during installation" and Device Flow disabled. Enable "Redirect on update"
# so configuring an existing installation returns to ReviewDuck. ReviewDuck
# starts its own PKCE verification after installation or update. Set the
# webhook URL to ${APP_URL}/api/webhooks/github, Contents to read, Pull requests
# to read/write, and subscribe to Pull request events. Make the App public for
# SaaS. App ID, client ID, and slug are on the App settings page. Generate a
# client secret and private key there. Paste the complete downloaded PEM,
# including its BEGIN/END lines, into Vercel.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=""
# Generate with `openssl rand -base64 32` and enter the same value in the
# GitHub App's Webhook secret field.
GITHUB_WEBHOOK_SECRET=""

# Create a GitLab.com group-owned OAuth application under Group settings >
# Applications so the integration is owned by the ReviewDuck organization:
# https://docs.gitlab.com/integration/oauth_provider/
# Use ${APP_URL}/gitlab/complete as the redirect URI and select only the api
# scope. Keep the application confidential. Copy the Application ID and Secret
# field, store the secret securely, and renew it from GitLab when needed.
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""

# Managed SaaS AI. Production fails closed when the catalog is absent.
# Create a Management API key, not an ordinary inference key:
# https://openrouter.ai/docs/guides/overview/auth/management-api-keys
OPENROUTER_MANAGEMENT_KEY=""
# One exact ID from https://openrouter.ai/models. Select a model that supports
# Tools and has a Zero Data Retention endpoint. SaaS uses it for every account.
OPENROUTER_MODEL_ALLOWLIST=""
MANAGED_AI_DAILY_REQUEST_LIMIT="40"
MANAGED_AI_USER_DAILY_REQUEST_LIMIT="10"
MANAGED_AI_FREE_MONTHLY_TOKEN_LIMIT="100000"
MANAGED_AI_PAID_MONTHLY_TOKEN_LIMIT="20000000"
MANAGED_AI_SCALE_MONTHLY_TOKEN_LIMIT="200000000"
MANAGED_AI_ULTRA_MONTHLY_TOKEN_LIMIT="1000000000"
AI_MAX_MODEL_STEPS="64"
AI_MAX_TOOL_CALLS="256"
AI_MAX_DISTINCT_FILES="200"
AI_MAX_SOURCE_BYTES="8388608"
AI_MAX_DURATION_MS="1800000"

# Deep pull-request review. Coverage is never capped: every selected file is
# reviewed, and the slot counts only bound how many run at the same instant.
DEEP_REVIEW_EXECUTION_SLOTS="4"
DEEP_REVIEW_TOOL_SLOTS="4"
# Durable model turns per file, and the changed-line count above which a file
# earns a pre-scan planning call.
DEEP_REVIEW_FILE_MAX_TURNS="3"
DEEP_REVIEW_PLAN_LINE_THRESHOLD="50"
# Optional run-wide relocation guard, and the surviving-finding count below
# which deduplication skips its clustering call.
DEEP_REVIEW_RELOCATION_LIMIT="20"
DEEP_REVIEW_DEDUPE_MIN="3"

# Create a Next.js project at https://sentry.io. In Project settings > Client
# Keys (DSN), copy the DSN into SENTRY_DSN for server reporting and into
# NEXT_PUBLIC_SENTRY_DSN for browser reporting.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# These are labels, not credentials. Keep both equal within an environment.
SENTRY_ENVIRONMENT="production"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
# Copy the organization and project slugs from the Sentry URL or their General
# Settings pages; use slugs rather than display names.
SENTRY_ORG=""
SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN is also required in Vercel at build time for source-map
# uploads. Create an organization token through Sentry Settings > Custom
# Integrations, keep it Sensitive, and do not store it in a developer .env:
# https://docs.sentry.io/api/guides/create-auth-token/
SENTRY_AUTH_TOKEN=""

# One authenticated daily maintenance invocation.
# Generate with `openssl rand -base64 32`. Vercel Cron sends it as the bearer
# token when invoking the maintenance path declared in vercel.json.
CRON_SECRET=""
SOURCE_RETENTION_DAYS="30"
SOURCE_RETENTION_SNAPSHOTS="5"

ALLOW_PRIVATE_PROVIDER_HOSTS="false"
ALLOW_PRIVATE_AI_HOSTS="false"
