# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# "authenticated" uses Clerk. "local" is a trusted single-user mode intended
# only for loopback access; the published Docker image sets this itself.
DEPLOYMENT_MODE="authenticated"

# Drizzle
# Application traffic uses PlanetScale's transaction-pooled PgBouncer port.
DATABASE_URL="postgresql://user:password@host.psdb.cloud:6432/postgres?sslmode=verify-full&sslrootcert=system"
# Schema migrations require a direct Postgres connection.
MIGRATION_DATABASE_URL="postgresql://user:password@host.psdb.cloud:5432/postgres?sslmode=verify-full&sslrootcert=system"

# Clerk authentication (required only when DEPLOYMENT_MODE="authenticated")
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_replace_me"

# Generate with: openssl rand -base64 48
ENCRYPTION_KEY=""
# Rotate by changing the ID and key while retaining old ID-to-key mappings as JSON.
ENCRYPTION_KEY_ID="primary"
ENCRYPTION_PREVIOUS_KEYS="{}"

# Source snapshots are pruned when either boundary is exceeded.
SOURCE_RETENTION_DAYS="30"
SOURCE_RETENTION_SNAPSHOTS="5"

# Set true only for a trusted private GitLab/GitHub Enterprise/Azure DevOps host.
ALLOW_PRIVATE_PROVIDER_HOSTS="false"
# Required for a trusted LAN/local Ollama-compatible endpoint.
ALLOW_PRIVATE_AI_HOSTS="false"

# AI agent runtime
FLUE_BASE_URL="http://localhost:3100"
FLUE_INTERNAL_SECRET=""
# Optional bearer secret for the durable AI dispatcher cron endpoint.
CRON_SECRET=""

# Managed-model guardrails
MANAGED_AI_DAILY_REQUEST_LIMIT="40"
MANAGED_AI_WEEKLY_TOKEN_LIMIT="250000"
MANAGED_AI_MODEL="gpt-5-mini"
